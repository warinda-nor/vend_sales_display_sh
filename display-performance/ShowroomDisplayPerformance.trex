<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.boonthavorn.showroom-display-performance" extension-version="1.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Showroom Display Performance — Sales performance comparison between Display and Non-Display articles across showrooms</description>
    <author name="Warinda" email="warinda.nor@boonthavorn.com" organization="Boonthavorn" website="https://github.com/warinda-nor/vend_sales_display_sh"/>
    <min-api-version>1.4</min-api-version>
    <source-location>
      <url>https://warinda-nor.github.io/vend_sales_display_sh/display-performance/index.html</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Showroom Display Performance</text>
    </resource>
  </resources>
</manifest>
